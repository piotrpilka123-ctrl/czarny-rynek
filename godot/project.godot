; Czarny Rynek — projekt Godot 4
config_version=5

[application]

config/name="Czarny Rynek"
boot_splash/bg_color=Color(0.027, 0.035, 0.051, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/description="Fikcyjna gra pierwszoosobowa: produkcja, klienci, negocjacje, policja, dług."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

D="*res://scripts/data.gd"
G="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

night={
"type": "float",
"value": 0.0
}
wet={
"type": "float",
"value": 0.0
}
